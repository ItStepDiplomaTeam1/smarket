DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
REDIS_URL=redis://localhost:6379
SECRET_KEY=replace_with_the_same_long_random_value_as_gateway
APP_HOST=0.0.0.0
APP_PORT=8001
APP_WORKERS=4
DEBUG=False
LOG_LEVEL=INFO
# Cookie settings (lax/none/strict)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
FRONTEND_URL=

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# SMTP configuration for email OTP/receipt dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

