GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_MODEL=openrouter/free

SEARCH_SERVICE_URL=http://search_service:8083/api/v1
PRODUCT_SERVICE_URL=http://product_service:8000/api/v1
CART_SERVICE_URL=http://cart_service:8002/cart
REVIEWS_SERVICE_URL=http://reviews_service:8004/reviews
REDIS_URL=redis://redis:6379

PORT=8005

ZEPHYROS_ROUTING_MODE=parallel-race
ZEPHYROS_PARALLEL_COHORT_PERCENT=100
ZEPHYROS_ACTION_EXECUTOR_ENABLED=true
ZEPHYROS_OPERATOR_KEY=

PROVIDER_TIMEOUT_SECONDS=18
PROVIDER_CONCURRENCY_LIMIT=8
CHAT_REQUEST_BUDGET_SECONDS=22
CHAT_CACHE_TTL_SECONDS=45
CHAT_SINGLEFLIGHT_TTL_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_SUCCESS_RATE_SLO=0.995
CHAT_LATENCY_P95_SLO_MS=12000
