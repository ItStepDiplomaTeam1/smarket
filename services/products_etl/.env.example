MONGO_URI=mongodb://localhost:27017/

DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

ENV=development

# Shared secret used only for ETL -> search_service index mutations.
SEARCH_INTERNAL_API_TOKEN=replace_with_a_long_random_value

# API key for ETL admin control endpoint (POST /admin/etl/control)
ETL_ADMIN_KEY=your_secret_admin_key_here
