# Використовуємо офіційний мінімальний образ Python 3.12
FROM python:3.12-slim

# Встановлюємо робочу директорію всередині контейнера
WORKDIR /app

# Копіюємо файл із залежностями
COPY requirements.txt .

# Встановлюємо бібліотеки без кешування, щоб зменшити розмір образу
RUN pip install --no-cache-dir -r requirements.txt

# Копіюємо весь наш код (папку src) у контейнер
COPY src/ ./src/

# Вказуємо команду, яка буде виконуватися при старті контейнера
CMD ["faststream", "run", "src.main:app"]