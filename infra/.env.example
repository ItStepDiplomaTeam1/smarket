# Use independent, URL-safe random values of at least 32 characters.
# Never commit the real .env file.
REDIS_PASSWORD=replace_with_a_long_random_value
RABBITMQ_USER=smarket
RABBITMQ_PASS=replace_with_a_long_random_value
MONGO_USER=admin
MONGO_PASS=replace_with_a_long_random_value
MEILISEARCH_API_KEY=replace_with_a_long_random_value
SEARCH_INTERNAL_API_TOKEN=replace_with_a_different_long_random_value
ETL_ADMIN_KEY=replace_with_a_different_long_random_value

# Production cross-site refresh cookie policy.
SMARKET_AUTH_COOKIE_SECURE=true
SMARKET_AUTH_COOKIE_SAMESITE=none
# Keep empty for a host-only cookie on smarket-api.duckdns.org.
SMARKET_AUTH_COOKIE_DOMAIN=
